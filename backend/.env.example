# Copy to .env and fill in. NEVER commit the filled file.

LIULI_APP_ENV=prod
LIULI_APP_VERSION=0.2.2

# PostgreSQL in production; SQLite is fine for local evaluation only.
LIULI_DATABASE_URL=postgresql+psycopg://liuli:CHANGE_ME@127.0.0.1:5432/liuli

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LIULI_SECRET_KEY=CHANGE_ME_32_BYTES_MINIMUM
# Exactly 32 random bytes, base64url:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LIULI_CERT_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
LIULI_CODE_PEPPER=CHANGE_ME_RANDOM
LIULI_DOC_PEPPER=CHANGE_ME_RANDOM

LIULI_PLATFORM_DOMAIN=liuli.example
LIULI_NS_HOSTNAMES=ns1.liuli.example,ns2.liuli.example
LIULI_PUBLIC_BASE_URL=https://api.liuli.example
LIULI_DNS_HOST=0.0.0.0
LIULI_DNS_PORT=53
LIULI_DNS_RESOLVERS=8.8.8.8,1.1.1.1

# SMTP (leave empty for dev outbox)
LIULI_SMTP_HOST=smtp.example.com
LIULI_SMTP_PORT=587
LIULI_SMTP_USER=no-reply@liuli.example
LIULI_SMTP_PASSWORD=CHANGE_ME
LIULI_SMTP_FROM=no-reply@liuli.example
LIULI_SMTP_STARTTLS=true
LIULI_REALNAME_INBOX=realname@liuli.example

# Admin console (python -m app.cli init-admin)
LIULI_ADMIN_EMAIL=admin@liuli.example
LIULI_ADMIN_PASSWORD_HASH=$argon2id$...
LIULI_ADMIN_TOTP_SECRET=CHANGE_ME_BASE32

# Limits
LIULI_GLOBAL_IP_PER_MINUTE=600
LIULI_GLOBAL_INSTANCE_PER_MINUTE=5000
LIULI_DNS_QPS_PER_IP=50
LIULI_DNS_QPS_GLOBAL=2000

# Behind a trusted reverse proxy only:
LIULI_TRUST_PROXY_HEADERS=true
# Optional Redis for shared limits (single instance uses memory otherwise)
LIULI_REDIS_URL=

# Cloudflare Tunnel (server-side only; never put these in the client)
LIULI_PLATFORM_ZONE_ID=CHANGE_ME_ZONE_ID
LIULI_CLOUDFLARE_ACCOUNT_ID=CHANGE_ME_ACCOUNT_ID
LIULI_CLOUDFLARE_API_TOKEN=CHANGE_ME_API_TOKEN
LIULI_CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
LIULI_TUNNEL_PROXY_PORT=8787
LIULI_TUNNEL_CONTROL_PORT=8788
LIULI_TUNNEL_WARN_CONNECTIONS=800
LIULI_TUNNEL_MAX_CONNECTIONS=1000
# LIULI_TUNNEL_BINARY=/usr/lib/liuli-dns/liuli-tunnel
# LIULI_CLOUDFLARED_BINARY=/usr/lib/liuli-dns/cloudflared

# Optional free-domain provider; leave blank to disable the feature.
LIULI_DNSHE_API_BASE=https://api005.dnshe.com/index.php
LIULI_DNSHE_API_KEY=
LIULI_DNSHE_API_SECRET=
